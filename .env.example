# Environment Variables Template for Antigravity Agent Core

# Gitea Self-Hosted Configuration
GITEA_HOST=http://localhost:3000
GITEA_TOKEN=your_gitea_access_token_here

# GitHub Configuration
GITHUB_PAT=your_github_personal_access_token_here

# Application Runtime Configuration
NODE_ENV=development
PORT=3000

# --- MCP Database Server Variables ---
# Update these based on your target local/remote database
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=secret
DB_NAME=my_database

# Custom Port Overrides
DB_PORT_PG=5432
DB_PORT_MYSQL=3306
DB_PORT_MSSQL=1433
