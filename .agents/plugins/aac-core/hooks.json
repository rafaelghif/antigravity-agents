{
  "aac-production-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo ..); python3 $ROOT/scripts/hooks/pre_tool_hitl.py'",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "aac-delegation-gate": {
    "PreToolUse": [
      {
        "matcher": "invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo ..); python3 $ROOT/scripts/hooks/pre_tool_delegation.py'",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "aac-quality-gate": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo ..); python3 $ROOT/scripts/hooks/pre_tool_quality_gate.py'",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "aac-pre-invoke-master": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "bash -c 'ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo ..); python3 $ROOT/scripts/hooks/pre_invoke_master.py'",
        "timeout": 30
      }
    ]
  },
  "aac-post-invoke-telemetry": {
    "PostInvocation": [
      {
        "type": "command",
        "command": "bash -c 'ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo ..); python3 $ROOT/scripts/hooks/post_invoke_telemetry.py'",
        "timeout": 30
      }
    ]
  },
  "aac-post-invoke-verify": {
    "PostInvocation": [
      {
        "type": "command",
        "command": "bash -c 'ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo ..); python3 $ROOT/scripts/hooks/post_invoke_verify.py'",
        "timeout": 30
      }
    ]
  }
}