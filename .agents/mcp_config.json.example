{
  "mcpServers": {
    "github": {
      "serverURL": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PAT}"
      }
    },
    "gitea": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITEA_HOST=${GITEA_HOST}",
        "-e",
        "GITEA_ACCESS_TOKEN=${GITEA_TOKEN}",
        "gitea/gitea-mcp:latest"
      ]
    }
  }
}
