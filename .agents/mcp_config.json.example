{
  "mcpServers": {
    "github": {
      "serverURL": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PAT}"
      }
    },
    "gitea": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITEA_PAT",
        "docker.gitea.com/gitea-mcp-server"
      ],
      "env": {
        "GITEA_PAT": "<YOUR_GITEA_TOKEN>"
      }
    }
  }
}

