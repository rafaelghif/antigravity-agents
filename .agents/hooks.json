{
  "aac-delegation-guard": {
    "PreToolUse": [
      {
        "matcher": "replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo ..); python3 $ROOT/scripts/strict_delegation_guard.py'"
          },
          {
            "type": "command",
            "command": "bash -c 'ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo ..); python3 $ROOT/scripts/manager_blindfold.py'"
          }
        ]
      },
      {
        "matcher": "view_file|grep_search|list_dir|find_by_name",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo ..); python3 $ROOT/scripts/manager_blindfold.py'"
          }
        ]
      }
    ]
  },
  "aac-auto-verify": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo ..); if ! python3 $ROOT/scripts/verify.py --execute; then echo \"{\\\"prompt\\\": \\\"Tests failed after your changes. Please review the errors and fix them.\\\"}\"; else echo \"{}\"; fi'"
          }
        ]
      }
    ]
  }
}
