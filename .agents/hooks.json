{
  "git-guardrails": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/block-dangerous-git.cjs",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "quality-gate": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "node hooks/verify-on-stop.cjs",
        "timeout": 15
      }
    ]
  }
}
