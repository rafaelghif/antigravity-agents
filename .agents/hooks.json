{
  "git-guardrails": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File hooks/block-dangerous-git.ps1",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
