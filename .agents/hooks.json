{
  "auto-verify": {
    "postToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c \"python3 scripts/verify.py > /dev/null 2>&1; echo '{}'\""
          }
        ]
      }
    ]
  }
}
