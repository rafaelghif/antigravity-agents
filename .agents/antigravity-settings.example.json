{
  "agentMode": "accept-edits",
  "allowNonWorkspaceAccess": true,
  "artifactReviewPolicy": "auto",
  "colorScheme": "tokyo night",
  "enableTerminalSandbox": false,
  "model": "Gemini 3.8 Flash (High)",
  "permissions": {
    "allow": [
      "command(*)",
      "write_file(*)",
      "write_to_file(*)",
      "replace_file_content(*)",
      "read_file(*)",
      "view_file(*)",
      "grep_search(*)",
      "find_by_name(*)",
      "list_dir(*)",
      "search_web(*)",
      "read_url_content(*)",
      "read_browser_page(*)",
      "invoke_subagent(*)",
      "send_message(*)",
      "manage_subagents(*)",
      "define_subagent(*)",
      "manage_task(*)",
      "schedule(*)",
      "ask_question(*)",
      "generate_image(*)",
      "call_mcp_tool(*)",
      "list_resources(*)",
      "read_resource(*)",
      "mcp(*)"
    ],
    "deny": [
      "command(rm -rf /)"
    ],
    "ask": []
  },
  "toolPermission": "always-proceed",
  "trustedWorkspaces": [
    "/path/to/your/workspace"
  ],
  "verbosity": "low"
}