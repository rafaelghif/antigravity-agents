{
  "toolPermission": "proceed",
  "enableTerminalSandbox": true,
  "allowNonWorkspaceAccess": false,
  "artifactReviewPolicy": "asks-for-review",
  "permissions": {
    "allow": [
      "command(*)",
      "write_file(*)",
      "replace_file_content(*)",
      "mcp(*)"
    ],
    "deny": [
      "command(rm -rf)",
      "command(sudo)",
      "command(curl .*)",
      "write_file(.git/)",
      "write_file(~/.ssh/)",
      "read_file(~/.ssh/)",
      "write_file(/home/*/.ssh/)",
      "read_file(/home/*/.ssh/)"
    ],
    "ask": [
      "read_url(*)",
      "execute_url(*)"
    ]
  }
}
