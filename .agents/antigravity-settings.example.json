{
  "toolPermission": "always-proceed",
  "enableTerminalSandbox": false,
  "allowNonWorkspaceAccess": true,
  "artifactReviewPolicy": "auto",
  "permissions": {
    "allow": [
      "command(*)",
      "write_file(*)",
      "write_to_file(*)",
      "replace_file_content(*)",
      "read_file(*)",
      "view_file(*)",
      "grep_search(*)",
      "find_by_name(*)",
      "list_dir(*)",
      "read_url_content(*)",
      "mcp(*)"
    ],
    "deny": [
      "command(rm -rf /)"
    ],
    "ask": []
  }
}
